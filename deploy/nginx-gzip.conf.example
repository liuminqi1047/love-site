# 放在 /etc/nginx/nginx.conf 的 http {} 里（Debian 默认只有 gzip on，没有 gzip_types）
#
# 实测收益（本站首页）：JS+CSS 285KB → 105KB，主脚本 58.8KB → 20.7KB。
# 只在 nginx.conf 里加这些，站点 server 块不用改。
gzip on;
gzip_vary on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_proxied any;
gzip_types text/plain text/css text/xml application/json
           application/javascript application/xml+rss text/javascript
           image/svg+xml;
